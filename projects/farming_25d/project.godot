; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for retro 2.5D FPS projects, direct configuration ensures pixel-perfect settings.


[application]

config/name="2.5D FARMING & RETRO FPS HYBRID"
config/description="Retro 2.5D First-Person Farming Simulation and Horde Shooter in Godot 4.x"
config/version="1.0.0"
run/main_scene="res://scenes/main_game_world.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://ui_ux/icons/extras/icon_extra_gemstones.png"


[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"

window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=false
anti_aliasing/screen_space_roughness_limiter/enabled=false
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024

2d/snap/snap_2d_transforms_to_pixel=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
textures/canvas_textures/default_texture_repeat=1

[input]

